# Copie este archivo como ".env" (junto a docker-compose.yml) y complete los valores.
# El archivo .env no debe subirse al repositorio.

# Clave que los clientes deben enviar en el header "ApiKey" (obligatoria).
# Genere una clave aleatoria, por ejemplo:
#   Linux/macOS: openssl rand -hex 32
#   PowerShell : $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); -join ($b | % { $_.ToString('x2') })
GPS_API_KEY=

# Puerto del host en el que se publica la API (por defecto 8080).
GPS_API_PORT=8080

# Habilita Swagger UI (/swagger) y el documento OpenAPI (/swagger/v1/swagger.json).
GPS_SWAGGER_ENABLED=true
